<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox nodeOrientation="RIGHT_TO_LEFT" prefHeight="332.0" prefWidth="293.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <TextField fx:id="nameExmintion">
         <VBox.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="10.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding></TextField>
      <TextArea fx:id="noteExmintion">
         <VBox.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="10.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding></TextArea>
      <VBox prefHeight="139.0" prefWidth="293.0">
         <children>
            <ImageView fx:id="imageExamintion" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            <Button fx:id="editImageExamintion" mnemonicParsing="false" onAction="#handleEditImageExamintion" text="تغيير الصورة" />
         </children>
      </VBox>
      <HBox alignment="CENTER" prefHeight="28.0" prefWidth="293.0">
         <children>
            <Button mnemonicParsing="false" prefHeight="28.0" prefWidth="90.0" text="حفظ التغيرات" />
            <Region prefHeight="25.0" prefWidth="76.0" />
            <Region prefHeight="22.0" prefWidth="30.0" />
            <Button fx:id="backEmintion" mnemonicParsing="false" onAction="#handleBackEmintion" text="تراجع" />
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
