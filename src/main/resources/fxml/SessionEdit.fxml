                                                        GridPane.columnIndex="0"
                                                        GridPane.rowIndex="0"/>

                                                <TextField
                                                        fx:id="txtSelectedExamName"
                                                        promptText="مثال: تحليل CBC"
                                                        GridPane.columnIndex="1"
                                                        GridPane.rowIndex="0"/>


                                                <Label
                                                        style="-fx-font-weight: bold;"
                                                        text="ملاحظات:"
                                                        GridPane.columnIndex="2"
                                                        GridPane.rowIndex="0"/>

                                                <TextField
                                                        fx:id="txtSelectedExamNotes"
                                                        promptText="ملاحظات الفحص"
                                                        GridPane.columnIndex="3"
                                                        GridPane.rowIndex="0"/>


                                                <Label
                                                        style="-fx-font-weight: bold;"
                                                        text="الصورة:"
                                                        GridPane.columnIndex="0"
                                                        GridPane.rowIndex="1"/>


                                                <HBox
                                                        alignment="CENTER_LEFT"
                                                        spacing="10.0"
                                                        GridPane.columnIndex="1"
                                                        GridPane.rowIndex="1">

                                                    <children>

                                                        <Button
                                                                mnemonicParsing="false"
                                                                onAction="#handleChooseExamImage"
                                                                style="-fx-background-color: #0284c7;
                                                                       -fx-text-fill: white;
                                                                       -fx-font-weight: bold;
                                                                       -fx-cursor: hand;"
                                                                text="📁 اختيار صورة"/>

                                                        <Label
                                                                fx:id="lblImagePath"
                                                                text="لم يتم اختيار صورة"
                                                                textFill="#64748b"
                                                                wrapText="true"/>

                                                    </children>

                                                </HBox>


                                                <HBox
                                                        alignment="CENTER_RIGHT"
                                                        spacing="10.0"
                                                        GridPane.columnIndex="3"
                                                        GridPane.rowIndex="1">

                                                    <children>

                                                        <Button
                                                                mnemonicParsing="false"
                                                                onAction="#handleUpdateExamRow"
                                                                style="-fx-background-color: #10b981;
                                                                       -fx-text-fill: white;
                                                                       -fx-font-weight: bold;
                                                                       -fx-cursor: hand;"
                                                                text="🔄 تحديث السطر المحدد"/>


                                                        <Button
                                                                mnemonicParsing="false"
                                                                onAction="#handleAddNewExamRow"
                                                                style="-fx-background-color: #4f46e5;
                                                                       -fx-text-fill: white;
                                                                       -fx-font-weight: bold;
                                                                       -fx-cursor: hand;"
                                                                text="➕ إضافة فحص جديد"/>

                                                    </children>

                                                </HBox>

                                            </children>

                                        </GridPane>

                                    </content>

                                </TitledPane>

                            </children>

                        </VBox>

                    </content>

                </Tab>

            </tabs>

        </TabPane>


        <!-- =====================================================
             BOTTOM BUTTONS
        ====================================================== -->

        <HBox
                alignment="CENTER_LEFT"
                prefHeight="60.0"
                spacing="15.0"
                style="-fx-background-color: #ffffff;
                       -fx-background-radius: 8;
                       -fx-border-color: #e2e8f0;
                       -fx-border-radius: 8;"
                AnchorPane.bottomAnchor="15.0"
                AnchorPane.leftAnchor="15.0"
                AnchorPane.rightAnchor="15.0">

            <padding>
                <Insets
                        left="20.0"
                        right="20.0"/>
            </padding>

            <children>

                <Button
                        mnemonicParsing="false"
                        onAction="#handleSaveChanges"
                        prefHeight="40.0"
                        prefWidth="200.0"
                        style="-fx-background-color: #10b981;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 14px;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;"
                        text="💾 حفظ جميع التعديلات"/>


                <Button
                        mnemonicParsing="false"
                        onAction="#handleCancel"
                        prefHeight="40.0"
                        prefWidth="130.0"
                        style="-fx-background-color: #ef4444;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 14px;
                               -fx-background-radius: 6;
                               -fx-cursor: hand;"
                        text="❌ إلغاء"/>

            </children>

        </HBox>

    </children>

</AnchorPane>