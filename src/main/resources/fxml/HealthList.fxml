<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox nodeOrientation="RIGHT_TO_LEFT" prefHeight="600.0" prefWidth="549.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="user_interface.offer.HealthList">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="58.0" prefWidth="538.0" spacing="10.0" style="-fx-padding: 15 15 5 15;">
         <children>
            <TextField fx:id="searchField" prefHeight="38.0" promptText="ابحث عن مرض أو حساسية (الاسم أو الرقم)..." style="-fx-border-color: #1e3a8a; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: #f8fafc;" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="Dubai Regular" size="14.0" />
               </font>
            </TextField>
            <ComboBox fx:id="comboSort" prefHeight="38.0" prefWidth="130.0" style="-fx-border-color: #1e3a8a; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: #ffffff; -fx-font-family: 'Dubai Regular'; -fx-font-size: 13px;" />
            <ToggleButton fx:id="btnReverse" mnemonicParsing="false" prefHeight="38.0" style="-fx-border-color: #1e3a8a; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-family: 'Dubai Bold'; -fx-font-size: 13px;" text="عكس الترتيب" textFill="#1e3a8a" />
         </children>
      </HBox>
      <ScrollPane fx:id="healths" fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="helthList" alignment="TOP_CENTER" spacing="10.0" style="-fx-padding: 10;" />
         </content>
      </ScrollPane>
   </children>
</VBox>
