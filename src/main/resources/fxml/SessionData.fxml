<AnchorPane nodeOrientation="RIGHT_TO_LEFT" prefHeight="750.0" prefWidth="950.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="user_interface.offer.SessionDataController">
