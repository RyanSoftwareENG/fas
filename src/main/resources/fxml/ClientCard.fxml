<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="-Infinity" prefHeight="75.0" prefWidth="630.0" spacing="15.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #dcdcdc; -fx-border-width: 1; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" nodeOrientation="RIGHT_TO_LEFT" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="user_interface.offer.ClintCard">
    <children>

        <HBox alignment="CENTER_RIGHT" spacing="20.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="nameCustomer" text="الاسم الكامل" textFill="#0f172a">
                    <font>
                        <Font name="Dubai Bold" size="14.0" />
                    </font>
                </Label>

                <Label fx:id="age" text="العمر: --" textFill="#475569">
                    <font>
                        <Font name="Dubai Regular" size="13.0" />
                    </font>
                </Label>

                <Label fx:id="gender" text="الجنس" textFill="#475569">
                    <font>
                        <Font name="Dubai Regular" size="13.0" />
                    </font>
                </Label>
            </children>
            <HBox.margin>
                <Insets left="15.0" right="15.0" />
            </HBox.margin>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <!-- زر التقرير البياني المضاف حديثاً -->
                <Button fx:id="btnReport" mnemonicParsing="false" onAction="#handleClientReport" prefHeight="32.0" prefWidth="75.0" style="-fx-background-color: #7c3aed; -fx-background-radius: 5; -fx-cursor: hand;" text="تقرير 📊" textFill="WHITE">
                    <font>
                        <Font name="Dubai Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="offerClient" mnemonicParsing="false" onAction="#handleOfferClient" prefHeight="32.0" prefWidth="75.0" style="-fx-background-color: #0284c7; -fx-background-radius: 5; -fx-cursor: hand;" text="عرض" textFill="WHITE">
                    <font>
                        <Font name="Dubai Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="editClient" mnemonicParsing="false" onAction="#handleEditClient" prefHeight="32.0" prefWidth="75.0" style="-fx-background-color: #f59e0b; -fx-background-radius: 5; -fx-cursor: hand;" text="تعديل" textFill="WHITE">
                    <font>
                        <Font name="Dubai Bold" size="12.0" />
                    </font>
                </Button>

                <Button fx:id="deleteClient" mnemonicParsing="false" onAction="#handleDeleteClient" prefHeight="32.0" prefWidth="75.0" style="-fx-background-color: #ef4444; -fx-background-radius: 5; -fx-cursor: hand;" text="حذف" textFill="WHITE">
                    <font>
                        <Font name="Dubai Bold" size="12.0" />
                    </font>
                </Button>
            </children>
            <HBox.margin>
                <Insets left="15.0" right="15.0" />
            </HBox.margin>
        </HBox>
    </children>
</HBox>